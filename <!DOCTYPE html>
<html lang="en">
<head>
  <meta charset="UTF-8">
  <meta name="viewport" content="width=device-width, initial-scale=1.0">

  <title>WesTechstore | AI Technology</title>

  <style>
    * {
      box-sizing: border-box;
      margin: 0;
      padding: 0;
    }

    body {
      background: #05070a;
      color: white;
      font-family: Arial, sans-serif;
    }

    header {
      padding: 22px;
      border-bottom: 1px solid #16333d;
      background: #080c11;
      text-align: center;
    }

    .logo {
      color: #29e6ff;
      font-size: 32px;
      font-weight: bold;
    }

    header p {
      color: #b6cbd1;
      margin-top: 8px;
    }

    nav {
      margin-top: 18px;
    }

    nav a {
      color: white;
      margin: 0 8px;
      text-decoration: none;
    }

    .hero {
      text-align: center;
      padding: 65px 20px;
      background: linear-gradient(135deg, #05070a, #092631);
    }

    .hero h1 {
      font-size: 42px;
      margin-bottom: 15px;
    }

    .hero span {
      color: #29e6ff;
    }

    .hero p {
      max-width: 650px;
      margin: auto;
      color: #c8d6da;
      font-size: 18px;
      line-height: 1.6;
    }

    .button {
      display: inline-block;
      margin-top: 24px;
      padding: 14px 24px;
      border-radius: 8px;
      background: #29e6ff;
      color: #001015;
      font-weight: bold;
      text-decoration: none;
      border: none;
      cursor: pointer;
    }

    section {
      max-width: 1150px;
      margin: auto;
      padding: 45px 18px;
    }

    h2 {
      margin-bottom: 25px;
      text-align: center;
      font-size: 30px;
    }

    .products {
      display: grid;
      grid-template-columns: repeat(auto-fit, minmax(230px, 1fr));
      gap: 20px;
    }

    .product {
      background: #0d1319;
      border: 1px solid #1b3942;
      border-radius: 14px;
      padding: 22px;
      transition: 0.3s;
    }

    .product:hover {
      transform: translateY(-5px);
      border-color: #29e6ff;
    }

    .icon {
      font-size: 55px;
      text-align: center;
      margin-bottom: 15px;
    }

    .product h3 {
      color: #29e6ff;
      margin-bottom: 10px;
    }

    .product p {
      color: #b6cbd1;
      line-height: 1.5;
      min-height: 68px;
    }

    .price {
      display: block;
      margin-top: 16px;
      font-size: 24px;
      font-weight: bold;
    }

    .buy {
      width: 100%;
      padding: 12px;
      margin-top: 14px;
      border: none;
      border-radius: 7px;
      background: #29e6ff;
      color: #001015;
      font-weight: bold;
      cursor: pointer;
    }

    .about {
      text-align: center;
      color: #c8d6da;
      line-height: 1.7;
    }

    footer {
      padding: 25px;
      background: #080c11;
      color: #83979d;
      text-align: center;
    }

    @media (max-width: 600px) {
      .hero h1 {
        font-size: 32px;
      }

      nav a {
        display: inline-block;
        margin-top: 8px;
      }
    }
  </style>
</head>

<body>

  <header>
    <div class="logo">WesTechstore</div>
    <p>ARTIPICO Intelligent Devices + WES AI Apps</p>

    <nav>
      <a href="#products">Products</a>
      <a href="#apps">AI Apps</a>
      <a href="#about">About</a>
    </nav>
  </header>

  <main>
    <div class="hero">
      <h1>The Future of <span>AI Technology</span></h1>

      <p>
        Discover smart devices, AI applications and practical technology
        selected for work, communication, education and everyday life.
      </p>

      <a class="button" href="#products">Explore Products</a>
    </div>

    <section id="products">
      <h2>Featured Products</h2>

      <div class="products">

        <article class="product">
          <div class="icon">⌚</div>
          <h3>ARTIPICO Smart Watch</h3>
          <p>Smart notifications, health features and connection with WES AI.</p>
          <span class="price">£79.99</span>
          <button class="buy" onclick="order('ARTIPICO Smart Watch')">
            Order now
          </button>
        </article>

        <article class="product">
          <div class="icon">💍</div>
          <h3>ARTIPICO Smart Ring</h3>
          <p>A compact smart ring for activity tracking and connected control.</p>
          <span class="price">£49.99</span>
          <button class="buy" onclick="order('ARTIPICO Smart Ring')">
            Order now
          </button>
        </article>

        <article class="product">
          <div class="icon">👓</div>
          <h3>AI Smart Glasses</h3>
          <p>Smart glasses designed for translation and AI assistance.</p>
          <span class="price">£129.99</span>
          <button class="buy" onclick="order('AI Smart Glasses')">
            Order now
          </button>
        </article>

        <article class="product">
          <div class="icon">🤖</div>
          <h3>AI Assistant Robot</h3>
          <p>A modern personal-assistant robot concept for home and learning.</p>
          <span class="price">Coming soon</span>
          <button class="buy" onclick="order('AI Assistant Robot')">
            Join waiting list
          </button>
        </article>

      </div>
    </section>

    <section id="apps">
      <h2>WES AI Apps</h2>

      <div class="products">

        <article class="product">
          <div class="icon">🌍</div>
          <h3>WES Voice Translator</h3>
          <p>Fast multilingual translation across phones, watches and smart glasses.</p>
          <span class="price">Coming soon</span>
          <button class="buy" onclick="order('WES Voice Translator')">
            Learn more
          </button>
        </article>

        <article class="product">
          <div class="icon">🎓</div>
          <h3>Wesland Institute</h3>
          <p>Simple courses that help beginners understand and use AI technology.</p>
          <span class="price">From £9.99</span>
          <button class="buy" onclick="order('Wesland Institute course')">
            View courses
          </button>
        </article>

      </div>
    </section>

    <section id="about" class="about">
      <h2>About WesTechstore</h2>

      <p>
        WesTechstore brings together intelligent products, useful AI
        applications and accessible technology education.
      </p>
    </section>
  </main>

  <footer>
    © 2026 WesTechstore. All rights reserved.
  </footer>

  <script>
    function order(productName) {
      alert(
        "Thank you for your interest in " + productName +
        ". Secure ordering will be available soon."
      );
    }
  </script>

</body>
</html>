<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>WesTechstore | AI Technology</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: #05070a;
      color: white;
      font-family: Arial, sans-serif;
    }

    header {
      padding: 22px;
      border-bottom: 1px solid #16333d;
      background: #080c11;
      text-align: center;
    }

    .logo {
      color: #29e6ff;
      font-size: 32px;
      font-weight: bold;
    }

    header p {
      color: #b6cbd1;
      margin-top: 8px;
    }

    nav {
      margin-top: 18px;
    }

    nav a {
      color: white;
      margin: 0 8px;
      text-decoration: none;
    }

    .hero {
      text-align: center;
      padding: 65px 20px;
      background: linear-gradient(135deg, #05070a, #092631);
    }

    .hero h1 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .hero span {
      color: #29e6ff;
    }

    .hero p {
      max-width: 650px;
      margin: auto;
      color: #c8d6da;
      font-size: 18px;
      line-height: 1.6;
    }

    .button {
      display: inline-block;
      margin-top: 24px;
      padding: 14px 24px;
      border-radius: 8px;
      background: #29e6ff;
      color: #001015;
      font-weight: bold;
      text-decoration: none;
      border: none;
      cursor: pointer;
    }

    section {
      max-width: 1150px;
      margin: auto;
      padding: 45px 18px;
    }

    h2 {
      margin-bottom: 25px;
      text-align: center;
      font-size: 30px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 20px;
    }

    .product {
      background: #0d1319;
      border: 1px solid #1b3942;
      border-radius: 14px;
      padding: 22px;
      transition: 0.3s;
    }

    .product:hover {
      transform: translateY(-5px);
      border-color: #29e6ff;
    }

    .icon {
      font-size: 55px;
      text-align: center;
      margin-bottom: 15px;
    }

    .product h3 {
      color: #29e6ff;
      margin-bottom: 10px;
    }

    .product p {
      color: #b6cbd1;
      line-height: 1.5;
      min-height: 68px;
    }

    .price {
      display: block;
      margin-top: 16px;
      font-size: 24px;
      font-weight: bold;
    }

    .buy {
      width: 100%;
      padding: 12px;
      margin-top: 14px;
      border: none;
      border-radius: 7px;
      background: #29e6ff;
      color: #001015;
      font-weight: bold;
      cursor: pointer;
    }

    .about {
      text-align: center;
      color: #c8d6da;
      line-height: 1.7;
    }

    footer {
      padding: 25px;
      background: #080c11;
      color: #83979d;
      text-align: center;
    }

    @media (max-width: 600px) {
      .hero h1 {
        font-size: 32px;
      }

      nav a {
        display: inline-block;
        margin-top: 8px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">WesTechstore</div>
    <p>ARTIPICO Intelligent Devices + WES AI Apps</p>

    <nav>
      <a href="#products">Products</a>
      <a href="#apps">AI Apps</a>
      <a href="#about">About</a>
    </nav>
  </header>

  <main>
    <div class="hero">
      <h1>The Future of <span>AI Technology</span></h1>

      <p>
        Discover smart devices, AI applications and practical technology
        selected for work, communication, education and everyday life.
      </p>

      <a class="button" href="#products">Explore Products</a>
    </div>

    <section id="products">
      <h2>Featured Products</h2>

      <div class="products">

        <article class="product">
          <div class="icon">⌚</div>
          <h3>ARTIPICO Smart Watch</h3>
          <p>Smart notifications, health features and connection with WES AI.</p>
          <span class="price">£79.99</span>
          <button class="buy" onclick="order('ARTIPICO Smart Watch')">
            Order now
          </button>
        </article>

        <article class="product">
          <div class="icon">💍</div>
          <h3>ARTIPICO Smart Ring</h3>
          <p>A compact smart ring for activity tracking and connected control.</p>
          <span class="price">£49.99</span>
          <button class="buy" onclick="order('ARTIPICO Smart Ring')">
            Order now
          </button>
        </article>

        <article class="product">
          <div class="icon">👓</div>
          <h3>AI Smart Glasses</h3>
          <p>Smart glasses designed for translation and AI assistance.</p>
          <span class="price">£129.99</span>
          <button class="buy" onclick="order('AI Smart Glasses')">
            Order now
          </button>
        </article>

        <article class="product">
          <div class="icon">🤖</div>
          <h3>AI Assistant Robot</h3>
          <p>A modern personal-assistant robot concept for home and learning.</p>
          <span class="price">Coming soon</span>
          <button class="buy" onclick="order('AI Assistant Robot')">
            Join waiting list
          </button>
        </article>

      </div>
    </section>

    <section id="apps">
      <h2>WES AI Apps</h2>

      <div class="products">

        <article class="product">
          <div class="icon">🌍</div>
          <h3>WES Voice Translator</h3>
          <p>Fast multilingual translation across phones, watches and smart glasses.</p>
          <span class="price">Coming soon</span>
          <button class="buy" onclick="order('WES Voice Translator')">
            Learn more
          </button>
        </article>

        <article class="product">
          <div class="icon">🎓</div>
          <h3>Wesland Institute</h3>
          <p>Simple courses that help beginners understand and use AI technology.</p>
          <span class="price">From £9.99</span>
          <button class="buy" onclick="order('Wesland Institute course')">
            View courses
          </button>
        </article>

      </div>
    </section>

    <section id="about" class="about">
      <h2>About WesTechstore</h2>

      <p>
        WesTechstore brings together intelligent products, useful AI
        applications and accessible technology education.
      </p>
    </section>
  </main>

  <footer>
    © 2026 WesTechstore. All rights reserved.
  </footer>

  <script>
    function order(productName) {
      alert(
        "Thank you for your interest in " + productName +
        ". Secure ordering will be available soon."
      );
    }
  </script>

</body>
</html>